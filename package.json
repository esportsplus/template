{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/reactivity": "link:../reactivity",
        "@esportsplus/typescript": "link:../typescript",
        "@esportsplus/utilities": "^0.28.6"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "jsdom": "^30.1.3",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=26"
    },
    "exports": {
        "./compiler": {
            "types": "./build/compiler/index.d.ts",
            "default": "./build/compiler/index.js"
        },
        "./compiler/tsc": {
            "types": "./build/compiler/plugins/tsc.d.ts",
            "default": "./build/compiler/plugins/tsc.js"
        },
        "./compiler/vite": {
            "types": "./build/compiler/plugins/vite.d.ts",
            "default": "./build/compiler/plugins/vite.js"
        },
        "./env": {
            "types": "./build/env.d.ts",
            "development": "./build/env.development.js",
            "default": "./build/env.js"
        },
        "./hmr": {
            "types": "./build/hmr.d.ts",
            "default": "./build/hmr.js"
        },
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        }
    },
    "files": [
        "build"
    ],
    "main": "./build/index.js",
    "name": "@esportsplus/template",
    "packageManager": "pnpm@11.10.0",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/template"
    },
    "scripts": {
        "agent:test": "pnpm typecheck && vitest run",
        "bench:compiled": "pnpm build && node bench/compiled/run-browser.mjs",
        "bench:corpus": "pnpm build && node bench/compiler/corpus.mjs",
        "bench:krausest": "pnpm build && vitest run --config vitest.krausest.config.ts",
        "bench:krausest:browser": "node bench/krausest/run-browser.mjs",
        "bench:run": "pnpm build && vitest bench --config vitest.bench.config.ts",
        "bench:virtual:browser": "node bench/virtual/run-browser.mjs",
        "build": "tsc -p tsconfig.build.json",
        "lint": "oxlint -c oxlintrc.json --type-aware --deny-warnings",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
        "-": "-",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build"
    },
    "type": "module",
    "types": "./build/index.d.ts",
    "version": "0.58.1"
}
